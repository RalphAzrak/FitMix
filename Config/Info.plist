<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Registers fitmix:// for password-reset links. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>FitMix auth links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fitmix</string>
			</array>
		</dict>
	</array>
	<!-- Lets the app reach the FitMix backend running on a Mac on the same Wi-Fi (plain http to a .local address).
	     Everything else still requires https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
