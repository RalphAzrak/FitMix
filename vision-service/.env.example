# Copy this file to .env and fill in what you have. .env is ignored by Git: never commit it.

# 1 = realistic fake data: no model downloads, no paid API calls, nothing leaves this machine.
MOCK_MODE=0

# Optional shared secret. When set, the app must send "Authorization: Bearer <token>" to /analyze, /search, /refine.
VISION_APP_TOKEN=

# Garment descriptions (one vision call per /analyze). https://platform.openai.com/api-keys
# Can be the same key as Backend/.env.
OPENAI_API_KEY=
# Any vision-capable model your account can use.
OPENAI_VISION_MODEL=gpt-5-mini
# low, high or auto. high reads small logos better and costs more.
OPENAI_IMAGE_DETAIL=auto

# Google Lens + Google Shopping results for POST /search. https://serpapi.com/manage-api-key
# Each /search uses 2 searches; repeats of the same garment and brand are cached.
SERPAPI_KEY=
# Google country and language for results (prices come back in that country's currency).
SERPAPI_COUNTRY=us
SERPAPI_LANGUAGE=en

# Where crops are uploaded so Google Lens can fetch them (a private bucket; Lens gets a short-lived signed link).
# Supabase dashboard → Project Settings → API. The service role key is a master key: keep it only here.
SUPABASE_URL=https://hdxpakrlayubyhagbrrw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CROP_BUCKET=vision-crops
# How long the signed crop link works, in seconds.
SIGNED_URL_SECONDS=300

# Online re-ranking: score = RERANK_IMAGE_WEIGHT * cosine(crop, thumbnail) + RERANK_ATTR_WEIGHT * attribute match.
RERANK_IMAGE_WEIGHT=0.8
RERANK_ATTR_WEIGHT=0.2
# Garment segmentation for photos (about 110 MB, downloaded on first run). 0 = describe photos as a whole.
SEGMENTATION=1
SEGMENTATION_MODEL=mattmdjaga/segformer_b2_clothes
# FashionCLIP image embeddings for catalog matching and re-ranking (about 600 MB, downloaded on first run).
EMBEDDINGS=1
EMBEDDING_MODEL=patrickjohncyh/fashion-clip
# The demo catalog (relative to vision-service/). Rebuild with scripts/make_sample_catalog.py or seed_catalog_ebay.py.
CATALOG_PATH=catalog/catalog.json
# Garments smaller than this fraction of the photo are ignored (e.g. shoes cut off at the edge). Shoes need half.
MIN_GARMENT_AREA=0.01
CATALOG_TOP_K=5
ONLINE_TOP_K=10

# Recent analyses kept in memory for /search, /refine and crop links.
CACHE_SIZE=64
CACHE_TTL_SECONDS=3600

PORT=8790
