# Copy this file to .env and fill in your key. .env is ignored by Git: never commit it.
OPENAI_API_KEY=

# Which OpenAI image model draws the avatar. If your account can't use it, the server falls back to gpt-image-2.
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# low, medium or high. Higher looks better and costs more per avatar.
OPENAI_IMAGE_QUALITY=medium

# 1 = return a placeholder picture without calling OpenAI: no key, no cost, nothing uploaded. For testing the app.
FITMIX_MOCK=0

# Most avatars one device may request per hour.
FITMIX_RATE_LIMIT_PER_HOUR=20

# A shared secret the app must send. run.sh creates one the first time and gives it to debug builds of the app.
FITMIX_APP_TOKEN=

# Retailer search for a garment picked in the live camera (POST /v1/garment-match).
# eBay Browse API keys (production keyset) from https://developer.ebay.com/my/keys. Free; never commit them.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Which eBay site to search. Prices come back in that site's currency.
EBAY_MARKETPLACE_ID=EBAY_US
# Which visual search providers receive the selected garment crop, comma-separated: ebay, google_lens, fixture.
# google_lens (Google Lens via Scrappa) is NEVER on unless listed here. fixture = labeled test data, nothing sent.
FITMIX_VISUAL_PROVIDERS=ebay
# Google Lens via Scrappa (scrappa.co). Its documented search takes a public image URL, so the crop is published at a
# short-lived URL on this server: FITMIX_PUBLIC_BASE_URL must be an https address Scrappa can reach.
SCRAPPA_API_KEY=
FITMIX_PUBLIC_BASE_URL=
# 1 = read each top listing's own page for its photo, price, currency, brand and product codes.
FITMIX_LISTING_ENRICHMENT=1
# Most garment searches one device may make per hour.
FITMIX_MATCH_RATE_LIMIT_PER_HOUR=120
