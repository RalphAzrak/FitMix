# Copy this file to .env and fill in your key. .env is ignored by Git: never commit it.
OPENAI_API_KEY=
# Studio Fit product matching. Uses the same backend OpenAI key. No other key is needed.
# The search model describes the scanned garment, then searches the web with the photo and that description
# to find direct product URLs. The backend checks the retailer pages and product photos.
OPENAI_SEARCH_MODEL=gpt-6.2-sol
# Compares each product photo found with the scanned garment.
OPENAI_MATCH_MODEL=gpt-4.1-mini

# Which OpenAI image model draws the avatar. If your account can't use it, the server falls back to gpt-image-2.
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# low, medium or high. Higher looks better and costs more per avatar.
OPENAI_IMAGE_QUALITY=medium
# Outfit and wardrobe preview quality. Portrait creation uses OPENAI_IMAGE_QUALITY.
FITMIX_PREVIEW_IMAGE_MODEL=gpt-image-2.6-flare
FITMIX_PREVIEW_IMAGE_QUALITY=low

# 1 = return a placeholder picture without calling OpenAI: no key, no cost, nothing uploaded. For testing the app.
FITMIX_MOCK=0

# Most avatars one device may request per hour.
FITMIX_RATE_LIMIT_PER_HOUR=20

# A shared secret the app must send. run.sh creates one the first time and gives it to debug builds of the app.
FITMIX_APP_TOKEN=

# Most garment searches one device may make per hour.
FITMIX_MATCH_RATE_LIMIT_PER_HOUR=120

# 3D avatars are built on this computer (README, "3D avatars"). Most builds one device may start per hour.
FITMIX_AVATAR3D_RATE_LIMIT_PER_HOUR=6
